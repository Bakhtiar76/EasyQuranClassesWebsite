# Easy Quran Classes — environment template
#
# Copy this file to `.env` and fill in real values there. `.env` is
# gitignored and blocked from Claude's Read/Edit tools and from common
# Bash/PowerShell read commands (see .claude/settings.json and
# .claude/hooks/guard-bash.mjs). Never paste real values into chat, commits,
# logs, or this example file.
#
# Nothing here is required until Phase I (cPanel/SSH) actually begins —
# no hosting exists yet as of this setup.

# Production site
EQC_PROD_DOMAIN=

# Staging site (if/when provisioned)
EQC_STAGING_DOMAIN=

# cPanel
EQC_CPANEL_URL=
EQC_CPANEL_USER=

# SSH (dedicated key for this project, stored outside the repo, passphrase-protected)
EQC_SSH_HOST=
EQC_SSH_PORT=22
EQC_SSH_USER=
EQC_SSH_KEY_PATH=

# WordPress
EQC_WP_PATH=
EQC_WP_ADMIN_URL=
