# Easy Quran Classes — environment template
#
# Copy this file to `.env` and fill in real values there. `.env` is
# gitignored and blocked from Claude's Read/Edit tools and from common
# Bash/PowerShell read commands (see .claude/settings.json and
# .claude/hooks/guard-bash.mjs). Never paste real values into chat, commits,
# logs, or this example file.
#
# This hosting account has no Shell/SSH/Terminal access (confirmed) — do not
# add SSH/key variables here. cPanel deployment is manual, via File Manager
# and phpMyAdmin; see CPANEL-WORKFLOW.md. Nothing here is required until
# release/deployment work actually begins.

# Production site
EQC_PROD_DOMAIN=https://easyquranclasses.com

# Staging site (if/when provisioned)
EQC_STAGING_DOMAIN=

# cPanel
EQC_CPANEL_URL=
EQC_CPANEL_USER=

# WordPress
EQC_WP_PATH=
EQC_WP_ADMIN_URL=
