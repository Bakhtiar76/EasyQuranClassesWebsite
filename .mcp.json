{
  "mcpServers": {
    "novamira-localhost": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "http://localhost/wp-json/mcp/novamira",
        "WP_API_USERNAME": "admin",
        "WP_API_PASSWORD": "${NOVAMIRA_APP_PASSWORD}"
      }
    }
  }
}
