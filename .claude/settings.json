{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.*.local)",
      "Read(wp-config.php)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.ppk)",
      "Read(*.crt)",
      "Read(id_rsa*)",
      "Read(*.sql)",
      "Read(*.sql.gz)",
      "Read(wp-content/backups*/**)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -r *)",
      "Bash(rm *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(wp db *)",
      "Bash(wp search-replace *)",
      "Bash(wp plugin delete *)",
      "Bash(wp plugin uninstall *)",
      "Bash(wp theme delete *)",
      "Bash(wp core update *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)"
    ],
    "allow": [
      "Bash(node --check *)",
      "Bash(wp --info)",
      "Bash(wp core version)",
      "Bash(wp plugin list *)",
      "Bash(wp theme list *)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "build-with-wordpress@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "taste-skill@taste-skill": false,
    "ponytail@ponytail": false,
    "codex@openai-codex": false,
    "claude-mem@thedotmack": false,
    "context-mode@context-mode": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-validate.mjs\""
          }
        ]
      }
    ]
  }
}
