# Easy Quran Classes — local Docker WordPress environment template.
#
# Copy to local/.env and adjust if needed. `local/.env` is gitignored
# (matched by the root .gitignore's `.env` / `.env.*` patterns). These
# are local-only development values — never reused in production.

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress

# WordPress admin account, created by `wp core install` (see local/README.md).
# Change locally any time with `wp user update admin --user_pass=...`.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-locally
WP_ADMIN_EMAIL=admin@example.test
